APP_NAME=CodeSpec AI
DEBUG=True
API_V1_PREFIX=/api/v1

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123

# Repositories Working Directory
REPO_WORKSPACE_DIR=./workspace/repos

# Qdrant vector store (private Docker network in Compose)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=codespec_chunks
QDRANT_VECTOR_SIZE=1024
QDRANT_TIMEOUT_SECONDS=10

# Local BGE-M3 model. Provision weights into this cache before offline use.
EMBEDDING_MODEL_PATH=BAAI/bge-m3
EMBEDDING_LOCAL_FILES_ONLY=True
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=./workspace/model-cache
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=1024

INDEX_MAX_CHUNK_CHARS=1800
INDEX_CHUNK_OVERLAP_LINES=2
INDEX_MIN_CHUNK_CHARS=20
INDEX_MAX_FILE_BYTES=2000000
INDEX_BATCH_SIZE=16
INDEX_TOP_K=8
INDEX_SCORE_THRESHOLD=0.0
INDEX_MAX_CONTEXT_CHARS=12000
IMPACT_MAX_DEPTH=3
IMPACT_MAX_RESULTS=200
INDEX_LOCK_TIMEOUT_SECONDS=3600
INDEX_LOCK_WAIT_SECONDS=30
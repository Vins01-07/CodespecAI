APP_NAME=CodeSpec AI
DEBUG=True
API_V1_PREFIX=/api/v1

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123

# Repositories Working Directory
REPO_WORKSPACE_DIR=./workspace/repos

# Vector Store (neo4j | in_memory)
VECTOR_STORE_PROVIDER=neo4j
VECTOR_INDEX_NAME=rag_chunk_embeddings
VECTOR_DIMENSIONS=1536

# Embedding Provider (mock | openai | gemini)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_NAME=text-embedding-3-small
# OPENAI_API_KEY=your-openai-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here

# LLM Generation (mock | openai | gemini | ollama)
LLM_PROVIDER=mock
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
LLM_REQUEST_TIMEOUT=30.0
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_BASE_URL=https://custom-openai-compatible-api.com/v1